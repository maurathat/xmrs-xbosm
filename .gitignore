# --- generated analysis artifacts (reproducible from code in ~6s) ----------
# These are OUTPUTS, not source. They get overwritten every run, so committing
# them bloats history and makes every run show as a spurious diff.
telemetry_scored.csv
policy_comparison.csv
degree_sweep.csv
summary.json

# raw capture: experimental DATA, not code. Keep backed up separately.
# If the paper needs a fixed/citable dataset, remove this line and commit it
# deliberately as a one-off (consider Git LFS if it's large).
xrpl_test_telemetry.csv

# throwaway connection-test captures
smoke.csv
*.smoke.csv

# --- python environment & bytecode -----------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class

# --- archives / Finder duplicates / junk -----------------------------------
files.zip
*.zip
# Finder "copy" duplicates, e.g. "burst copy.py", "README (2).md"
*\ copy.*
*\ copy\ *.*
*\ ([0-9]).*

# --- build artifacts & generated data --------------------------------------
*.egg-info/
data/processed/*
!data/processed/.gitkeep

# --- macOS / editor cruft --------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
*.swp
*.swo
.idea/
.vscode/
