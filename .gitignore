# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib

# Packaging / build
*.egg-info/
.eggs/
dist/
build/
*.egg
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment & secrets
.env
.env.*
!.env.example

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# Jupyter / notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/
profile_default/
ipython_log.py*

# Data science & ML artifacts (keep small fixtures in-repo intentionally)
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.feather
*.parquet
*.arrow
*.npy
*.npz
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors
mlruns/
wandb/
.dvc/cache

# Streamlit
.streamlit/secrets.toml

# Matplotlib font cache (local)
.matplotlib/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Conda
.conda/

# Logs
*.log

# Project outputs (tracked placeholders only)
outputs/logs/*
!outputs/logs/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
